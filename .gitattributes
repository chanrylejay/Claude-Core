# Hooks and nets are compared BYTE-FOR-BYTE against their installed copies
# (templates/global/_ritual_test.mjs fails closed on drift). core.autocrlf
# would rewrite the working tree to CRLF while the committed blob stays LF,
# which false-fails that check on every fresh checkout. Pin them to LF.
*.mjs text eol=lf
*.js  text eol=lf

# Codex install sources and capture hashes must survive autocrlf checkouts byte-for-byte.
templates/codex/*.json text eol=lf
templates/codex/fixtures/*.json text eol=lf
templates/codex/pre-push text eol=lf
templates/codex-agents-md.md text eol=lf
templates/codex-chan-guard.rules text eol=lf

# Batch 1a (Sep 12 2026): the shared-resolver fixtures are compared against pinned output.
templates/fixtures/* text eol=lf
